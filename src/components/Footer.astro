---
import { products } from "../data/products";
import logo from "../assets/logo-dark.png";

const legalLinks = [
  { label: "Confidentialité", href: "/privacy" },
  { label: "CGU", href: "/terms" },
  { label: "Mentions légales", href: "/legal" },
];

const studioLinks = [
  { label: "Gouvernance", href: "/#dna" },
  { label: "Fondateur", href: "/#founder" },
  { label: "Portfolio", href: "/#portfolio" },
  { label: "À propos", href: "/#about" },
];
---

<footer id="contact" class="bg-surface/40">
  <div class="mx-auto max-w-5xl border-surface-border px-6 py-14 md:border-x">
    <div
      class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between"
    >
      <div class="max-w-xs">
        <div class="flex items-center gap-2.5">
          <img src={logo.src} alt="" class="h-6 w-6 rounded-md" />
          <span
            class="text-[15px] font-semibold tracking-tight text-text-primary"
            >Lehmora Labs</span
          >
        </div>
        <p class="mt-4 text-xs leading-relaxed text-text-secondary">
          Venture studio d'ingénierie logicielle, spécialisé dans les
          infrastructures financières et institutionnelles pour marchés
          émergents.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3">
        <div>
          <p
            class="mb-4 font-mono text-[10px] uppercase tracking-widest text-text-muted"
          >
            Produits
          </p>
          <ul class="space-y-2.5">
            {
              products.map((product) => (
                <li>
                  <a
                    href={product.url}
                    target="_blank"
                    rel="noreferrer"
                    class="text-xs text-text-secondary transition-colors hover:text-text-primary"
                  >
                    {product.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p
            class="mb-4 font-mono text-[10px] uppercase tracking-widest text-text-muted"
          >
            Studio
          </p>
          <ul class="space-y-2.5">
            {
              studioLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-xs text-text-secondary transition-colors hover:text-text-primary"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p
            class="mb-4 font-mono text-[10px] uppercase tracking-widest text-text-muted"
          >
            Contact
          </p>
          <ul class="space-y-2.5">
            <li>
              <a
                href="mailto:contact@lehmora.com"
                class="text-xs text-text-secondary transition-colors hover:text-text-primary"
              >
                contact@lehmora.com
              </a>
            </li>
            <li>
              <a
                href="mailto:contact@lehmora.com?subject=Relation%20investisseurs"
                class="text-xs text-text-secondary transition-colors hover:text-text-primary"
              >
                Investisseurs &amp; partenaires
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-solid! border-surface-border pt-8 sm:flex-row"
    >
      <p class="font-mono text-[11px] text-text-muted">
        © 2026 Lehmora Labs. Tous droits réservés.
      </p>
      <div class="flex items-center gap-5">
        {
          legalLinks.map((link) => (
            <a
              href={link.href}
              class="font-mono text-[11px] text-text-muted transition-colors hover:text-text-secondary"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
