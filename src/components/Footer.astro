---
import Logo from "./Logo.astro";
import { listedProducts } from "../data/products";
import { getDict, type Lang } from "../i18n";

interface Props {
	lang: Lang;
	/** Same page in the other language; defaults to the other home page. */
	switchHref?: string;
}

const { lang } = Astro.props;
const dict = getDict(lang);
const t = dict.footer;
const switchHref = Astro.props.switchHref ?? dict.nav.switchHref;
---

<footer class="footer">
	<div class="frame footer__grid">
		<div class="footer__brand">
			<p class="footer__name"><Logo size={20} /> Lehmora Labs</p>
			<p class="footer__tagline">{t.tagline}</p>
		</div>

		<nav class="footer__cols" aria-label={dict.nav.footer}>
			<div>
				<p class="footer__heading">{dict.products.label}</p>
				<ul>
					{
						listedProducts.map((product) => (
							<li>
								<a href={product.url} target="_blank" rel="noreferrer">
									{product.name}
									<span class="sr-only">{dict.nav.newTab}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<p class="footer__heading">{dict.status.contactTitle}</p>
				<ul>
					<li><a href="mailto:contact@lehmora.com">contact@lehmora.com</a></li>
					<li><a href={dict.nav.journalHref}>{dict.nav.journal}</a></li>
					<li><a href="https://github.com/lehmora" target="_blank" rel="noreferrer">GitHub <span class="sr-only">{dict.nav.newTab}</span></a></li>
					<li>
						<a href={switchHref} hreflang={dict.nav.switchLang} lang={dict.nav.switchLang}>
							{dict.nav.switchLabel}
						</a>
					</li>
				</ul>
			</div>
		</nav>
	</div>

	<div class="frame footer__base">
		<p>{t.rights}</p>
		<ul>
			{t.legal.map((link) => <li><a href={link.href} hreflang="fr">{link.label}</a></li>)}
		</ul>
		{t.legalNote && <p class="footer__note">{t.legalNote}</p>}
	</div>
</footer>

<style>
	.footer {
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.footer a {
		overflow-wrap: anywhere;
		text-decoration: none;
		color: color-mix(in srgb, var(--color-paper) 78%, transparent);
		transition: color 0.15s ease;
	}

	.footer a:hover {
		color: var(--color-paper);
	}

	.footer :focus-visible {
		outline-color: var(--color-paper);
	}

	.footer__grid {
		display: grid;
		gap: 2.5rem;
		padding-block: 3.5rem 2.5rem;
	}

	.footer__name {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 700;
		font-stretch: 88%;
		font-size: 1.1rem;
	}

	.footer__tagline {
		max-width: 22rem;
		margin-top: 0.75rem;
		font-family: var(--font-serif);
		color: color-mix(in srgb, var(--color-paper) 78%, transparent);
	}

	.footer__cols {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
	}

	.footer__heading {
		margin-bottom: 0.75rem;
		font-weight: 600;
		font-size: 0.88rem;
		color: color-mix(in srgb, var(--color-paper) 60%, transparent);
	}

	.footer__cols li + li {
		margin-top: 0.45rem;
	}

	.footer__base {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-block: 1.5rem 2rem;
		border-top: 1px solid color-mix(in srgb, var(--color-paper) 16%, transparent);
		font-size: 0.85rem;
		color: color-mix(in srgb, var(--color-paper) 60%, transparent);
	}

	.footer__base ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.footer__note {
		flex-basis: 100%;
	}

	@media (min-width: 48rem) {
		.footer__grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}
</style>
