---
import { products } from "../data/products";
import logo from "../assets/logo-dark.png";

const legalLinks = [
  { label: "Confidentialité", href: "/privacy" },
  { label: "CGU", href: "/terms" },
  { label: "Mentions légales", href: "/legal" },
];

const studioLinks = [
  { label: "Gouvernance", href: "/#dna" },
  { label: "Fondateur", href: "/#founder" },
  { label: "Portfolio", href: "/#portfolio" },
  { label: "À propos", href: "/#about" },
];

const socialLinks = [
  { label: "X (Twitter)", href: "#" },
  { label: "LinkedIn", href: "#" },
  { label: "GitHub", href: "#" },
];
---

<footer id="contact" class="bg-surface/40">
  <div class="mx-auto max-w-5xl border-surface-border px-6 py-14 md:border-x">
    <div
      class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between"
    >
      <div class="max-w-xs">
        <div class="flex items-center gap-2.5">
          <img src={logo.src} alt="" class="h-6 w-6 rounded-md" />
          <span
            class="text-[15px] font-semibold tracking-tight text-text-primary"
            >Lehmora Labs</span
          >
        </div>
        <p class="mt-4 text-xs leading-relaxed text-text-secondary">
          Studio d'ingénierie logicielle et incubateur SaaS, spécialisé dans les
          infrastructures financières et institutionnelles pour marchés
          émergents.
        </p>

        <div class="mt-5 flex items-center gap-3">
          <a
            href={socialLinks[0].href}
            aria-label={socialLinks[0].label}
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-solid! border-surface-border text-text-muted transition-colors hover:text-text-primary"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.259 5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path>
            </svg>
          </a>
          <a
            href={socialLinks[1].href}
            aria-label={socialLinks[1].label}
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-solid! border-surface-border text-text-muted transition-colors hover:text-text-primary"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            href={socialLinks[2].href}
            aria-label={socialLinks[2].label}
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-solid! border-surface-border text-text-muted transition-colors hover:text-text-primary"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3">
        <div>
          <p
            class="mb-4 font-mono text-[10px] uppercase tracking-widest text-text-muted"
          >
            Produits
          </p>
          <ul class="space-y-2.5">
            {
              products.map((product) => (
                <li>
                  <a
                    href={product.url}
                    target="_blank"
                    rel="noreferrer"
                    class="text-xs text-text-secondary transition-colors hover:text-text-primary"
                  >
                    {product.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p
            class="mb-4 font-mono text-[10px] uppercase tracking-widest text-text-muted"
          >
            Studio
          </p>
          <ul class="space-y-2.5">
            {
              studioLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-xs text-text-secondary transition-colors hover:text-text-primary"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p
            class="mb-4 font-mono text-[10px] uppercase tracking-widest text-text-muted"
          >
            Contact
          </p>
          <ul class="space-y-2.5">
            <li>
              <a
                href="mailto:contact@lehmora.com"
                class="text-xs text-text-secondary transition-colors hover:text-text-primary"
              >
                contact@lehmora.com
              </a>
            </li>
            <li>
              <a
                href="mailto:contact@lehmora.com?subject=Relation%20investisseurs"
                class="text-xs text-text-secondary transition-colors hover:text-text-primary"
              >
                Investisseurs &amp; partenaires
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-solid! border-surface-border pt-8 sm:flex-row"
    >
      <p class="font-mono text-[11px] text-text-muted">
        © 2026 Lehmora Labs. Tous droits réservés.
      </p>
      <div class="flex items-center gap-5">
        {
          legalLinks.map((link) => (
            <a
              href={link.href}
              class="font-mono text-[11px] text-text-muted transition-colors hover:text-text-secondary"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
