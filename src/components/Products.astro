---
import Section from "./Section.astro";
import { flagshipScreens, listedProducts } from "../data/products";
import { getDict, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
const t = dict.products;
const tallyno = listedProducts.find((product) => product.slug === "tallyno");
const others = listedProducts.filter((product) => product.slug !== "tallyno");

// The SVG placeholders are meant to be swapped for real captures before launch.
const placeholders = flagshipScreens.filter((screen) => screen.src.endsWith(".svg"));
if (placeholders.length > 0 && import.meta.env.PROD) {
	console.warn(`[products] Placeholder screenshots still in use: ${placeholders.map((screen) => screen.src).join(", ")}`);
}
---

<Section id="products" label={t.label} title={t.title}>
	<p class="intro">{t.intro}</p>

	{tallyno && (
	<article class="flagship" aria-labelledby="flagship-name">
		<div class="flagship__text">
			<h3 id="flagship-name" class="flagship__name">
				<a class="link" href={tallyno.url} target="_blank" rel="noreferrer">
					{tallyno.name}
					<span class="sr-only">{dict.nav.newTab}</span>
				</a>
			</h3>
			<p class="flagship__tagline">{t.flagship.tagline}</p>
			<p class="flagship__meta">
				<span class:list={["status", `status--${tallyno.status}`]}>{t.statusLabels[tallyno.status]}</span>
				<span class="flagship__stack">{tallyno.stack.join(", ")}</span>
			</p>
			<ul class="flagship__points">
				{t.flagship.points.map((point) => <li>{point}</li>)}
			</ul>
		</div>

		<div class="screens" role="region" tabindex="0" aria-label={t.flagship.screensLabel}>
			{
				flagshipScreens.map((screen) => (
					<figure class="screen">
						<div class="phone">
							<img
								src={screen.src}
								width={screen.width}
								height={screen.height}
								alt={t.flagship.screens[screen.key].alt}
								loading="lazy"
								decoding="async"
							/>
						</div>
						<figcaption>{t.flagship.screens[screen.key].caption}</figcaption>
					</figure>
				))
			}
		</div>
	</article>
	)}

	<div class="others">
		<h3>{t.othersTitle}</h3>

		<!-- Explicit roles: Safari drops table semantics once rows are restyled with display: grid on phones. -->
		<table class="accounts" role="table">
			<thead role="rowgroup">
				<tr role="row">
					<th scope="col" role="columnheader">{t.cols.product}</th>
					<th scope="col" role="columnheader">{t.cols.purpose}</th>
					<th scope="col" role="columnheader">{t.cols.funds}</th>
					<th scope="col" role="columnheader">{t.cols.status}</th>
				</tr>
			</thead>
			<tbody role="rowgroup">
				{
					others.map((product) => (
						<tr role="row">
							<th scope="row" role="rowheader" class="accounts__name">
								<a
									class="link"
									href={product.url}
									target="_blank"
									rel="noreferrer"
								>
									{product.name}
									<span class="sr-only">{dict.nav.newTab}</span>
								</a>
							</th>
							<td role="cell" data-label={t.cols.purpose}>{t.items[product.slug].purpose}</td>
							<td role="cell" data-label={t.cols.funds} class:list={["accounts__funds", { "is-held": product.holdsFunds }]}>
								{t.items[product.slug].funds}
							</td>
							<td role="cell" data-label={t.cols.status}>
								<span class:list={["status", `status--${product.status}`]}>{t.statusLabels[product.status]}</span>
							</td>
						</tr>
					))
				}
			</tbody>
		</table>

		<p class="shared">
			{t.shared}{" "}
			<a class="link" href={dict.nav.journalHref}>{t.sharedLink}</a>
		</p>
	</div>
</Section>

<style>
	.intro {
		max-width: 40rem;
		margin-top: 1.75rem;
		font-family: var(--font-serif);
		font-size: 1.12rem;
		line-height: 1.65;
		color: var(--color-ink-2);
	}

	/* Flagship: the product in words on one side, in the hand on the other. */
	.flagship {
		display: grid;
		gap: 2.5rem;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1.5px solid var(--color-ink);
	}

	.flagship__name {
		font-weight: 800;
		font-stretch: 72%;
		font-size: clamp(2.6rem, 2rem + 2.4vw, 3.8rem);
		line-height: 1;
	}

	.flagship__tagline {
		margin-top: 0.5rem;
		font-family: var(--font-serif);
		font-size: 1.2rem;
	}

	.flagship__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin-top: 1rem;
		font-size: 0.95rem;
	}

	.flagship__stack {
		color: var(--color-ink-2);
	}

	.flagship__points {
		margin-top: 1.75rem;
		border-top: 1px solid var(--color-rule-strong);
	}

	.flagship__points li {
		padding: 0.8rem 0;
		border-bottom: 1px solid var(--color-rule);
		line-height: 1.5;
	}

	/* Phones: one screen per view, swiped sideways, so a capture stays legible. */
	.screens {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 74%;
		gap: 1rem;
		align-items: start;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding-bottom: 0.5rem;
	}

	.screens:focus-visible {
		outline-offset: 4px;
	}

	.screen {
		scroll-snap-align: start;
	}

	/* A plain device frame. The image keeps the ratio of its width and height
	   attributes, so any capture fits undistorted once those match the file. */
	.phone {
		padding: 0.5rem;
		background: var(--color-ink);
		border-radius: 1.6rem;
	}

	.phone img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 1.15rem;
		background: var(--color-sheet);
	}

	.screen figcaption {
		margin-top: 0.75rem;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--color-ink-2);
	}

	.status {
		display: inline-block;
		font-weight: 600;
	}

	.status--staging::before,
	.status--dev::before {
		content: "";
		display: inline-block;
		width: 0.55rem;
		height: 0.55rem;
		margin-right: 0.45rem;
		border: 1.5px solid var(--color-ink);
		border-radius: 50%;
		vertical-align: 0.05em;
	}

	/* Half-filled: running, but not in production. */
	.status--staging::before {
		background: linear-gradient(90deg, var(--color-ink) 50%, transparent 50%);
	}

	.others {
		margin-top: 4.5rem;
	}

	.others h3 {
		font-weight: 760;
		font-stretch: 80%;
		font-size: 1.5rem;
	}

	.accounts {
		width: 100%;
		margin-top: 1.25rem;
		border-collapse: collapse;
		border-top: 1.5px solid var(--color-ink);
	}

	.accounts thead {
		display: none;
	}

	.accounts tr {
		display: grid;
		gap: 0.5rem;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--color-rule);
	}

	.accounts td {
		display: grid;
		grid-template-columns: 8.5rem minmax(0, 1fr);
		gap: 0.75rem;
		font-size: 0.97rem;
	}

	.accounts td::before {
		content: attr(data-label);
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--color-ink-2);
	}

	.accounts__name {
		text-align: left;
		font-weight: 760;
		font-stretch: 80%;
		font-size: 1.4rem;
		line-height: 1.1;
	}

	.accounts__funds {
		color: var(--color-green);
		font-weight: 600;
	}

	.accounts__funds.is-held {
		color: var(--color-debit);
	}

	.shared {
		max-width: 40rem;
		margin-top: 1.5rem;
		font-size: 0.97rem;
		color: var(--color-ink-2);
	}

	@media (min-width: 40rem) {
		.screens {
			grid-auto-flow: row;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem;
			overflow: visible;
		}
	}

	@media (min-width: 60rem) {
		.flagship {
			grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
			gap: 2.5rem;
			align-items: start;
		}

		/* Stagger the two phones slightly, like screens laid on a desk. */
		.screen:last-child {
			margin-top: 3rem;
		}
	}

	/* Table mode only once the content column can hold four columns without overflowing. */
	@media (min-width: 64rem) {
		.accounts thead {
			display: table-header-group;
		}

		.accounts tr {
			display: table-row;
		}

		.accounts th,
		.accounts td {
			display: table-cell;
			padding: 1.15rem 1rem;
			vertical-align: top;
			border-bottom: 1px solid var(--color-rule);
		}

		.accounts td::before {
			content: none;
		}

		.accounts thead th {
			padding-block: 0.7rem;
			text-align: left;
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--color-ink-2);
			border-bottom: 1px solid var(--color-rule-strong);
		}

		.accounts th:first-child {
			padding-left: 0;
		}

		.accounts td {
			border-left: 1px solid var(--color-rule);
		}

		.accounts__funds {
			width: 32%;
		}

		.status {
			white-space: nowrap;
		}
	}
</style>
