---
import LedgerSheet from "./LedgerSheet.astro";
import { getDict, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).hero;
---

<section class="hero" aria-labelledby="hero-title">
	<div class="frame hero__grid">
		<div class="hero__text">
			<h1 id="hero-title" class="hero__title">{t.title}</h1>
			<p class="hero__lead">{t.lead}</p>
			<div class="hero__actions">
				<a class="btn btn--solid" href="#products">{t.ctaPrimary}</a>
				<a class="btn btn--ghost" href="mailto:contact@lehmora.com">{t.ctaSecondary}</a>
			</div>
		</div>

		<div class="hero__sheet">
			<LedgerSheet lang={lang} />
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: 3rem 4.5rem;
	}

	.hero__grid {
		display: grid;
		gap: 3rem;
		align-items: start;
	}

	/* The headline is written on the register's rulings: one ruled line per line of text. */
	.hero__title {
		--lh: 1.08em;
		max-width: 15ch;
		font-size: clamp(2.6rem, 1.2rem + 5.2vw, 5.4rem);
		font-weight: 800;
		font-stretch: 70%;
		line-height: var(--lh);
		letter-spacing: -0.015em;
		text-wrap: balance;
		background-image: repeating-linear-gradient(
			to bottom,
			transparent 0,
			transparent calc(var(--lh) - 2px),
			var(--color-rule) calc(var(--lh) - 2px),
			var(--color-rule) var(--lh)
		);
		padding-bottom: 0.08em;
	}

	.hero__lead {
		max-width: 36rem;
		margin-top: 1.75rem;
		font-family: var(--font-serif);
		font-size: clamp(1.1rem, 1rem + 0.35vw, 1.25rem);
		line-height: 1.6;
		color: var(--color-ink-2);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}

	@media (max-width: 30rem) {
		.hero__actions .btn {
			flex: 1 1 100%;
		}
	}

	@media (min-width: 64rem) {
		.hero {
			padding-block: 5.5rem 6.5rem;
		}

		.hero__grid {
			grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
			gap: 4.5rem;
		}

		.hero__sheet {
			padding-top: 0.6rem;
		}
	}
</style>
