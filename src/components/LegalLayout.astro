---
import Layout from "../layouts/Layout.astro";
import Header from "./react/Header";
import Footer from "./Footer.astro";

interface Props {
	title: string;
	updated: string;
}

const { title, updated } = Astro.props;
---

<Layout title={`${title} — Lehmora Labs`} description={title}>
	<Header client:load />
	<main class="mx-auto max-w-2xl px-6 py-20">
		<a href="/" class="text-sm text-text-secondary transition-colors hover:text-text-primary">
			← Retour à l'accueil
		</a>

		<h1 class="mt-6 text-3xl font-semibold tracking-tight text-text-primary sm:text-4xl">
			{title}
		</h1>
		<p class="mt-3 font-mono text-xs text-text-muted">Dernière mise à jour : {updated}</p>

		<div class="legal-content mt-12 text-[15px] leading-relaxed text-text-secondary">
			<slot />
		</div>
	</main>
	<Footer />
</Layout>

<style>
	.legal-content :global(h2) {
		margin-top: 2.5rem;
		margin-bottom: 0.75rem;
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--color-text-primary);
	}
	.legal-content :global(h2:first-child) {
		margin-top: 0;
	}
	.legal-content :global(p) {
		margin-top: 0.75rem;
	}
	.legal-content :global(ul) {
		margin-top: 0.75rem;
		padding-left: 1.25rem;
		list-style: disc;
	}
	.legal-content :global(li) {
		margin-top: 0.375rem;
	}
	.legal-content :global(a) {
		color: var(--color-text-primary);
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-color: var(--color-surface-border);
	}
	.legal-content :global(a:hover) {
		color: var(--color-lehmora);
	}
	.legal-content :global(strong) {
		color: var(--color-text-primary);
		font-weight: 500;
	}
</style>
