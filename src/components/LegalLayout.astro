---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "./SiteHeader.astro";
import Footer from "./Footer.astro";

interface Props {
	title: string;
	updated: string;
}

const { title, updated } = Astro.props;
---

<Layout lang="fr" title={`${title}, Lehmora Labs`} description={`${title} du site lehmora.com.`}>
	<a class="skip-link" href="#main">Aller au contenu</a>
	<SiteHeader lang="fr" />
	<main id="main" class="frame legal">
		<a href="/" class="legal__back link">Retour à l’accueil</a>
		<h1>{title}</h1>
		<p class="legal__updated">Dernière mise à jour&nbsp;: {updated}</p>

		<div class="legal__content">
			<slot />
		</div>
	</main>
	<Footer lang="fr" />
</Layout>

<style>
	.legal {
		max-width: 46rem;
		padding-block: 4rem 6rem;
	}

	.legal__back {
		font-size: 0.95rem;
		color: var(--color-ink-2);
	}

	h1 {
		margin-top: 1.5rem;
		font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.4rem);
		font-weight: 780;
		font-stretch: 75%;
		line-height: 1.04;
	}

	.legal__updated {
		margin-top: 0.75rem;
		font-size: 0.9rem;
		color: var(--color-ink-2);
		padding-bottom: 1.5rem;
		border-bottom: 1.5px solid var(--color-ink);
	}

	.legal__content {
		margin-top: 2.5rem;
		font-family: var(--font-serif);
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.legal__content :global(h2) {
		margin-top: 2.75rem;
		margin-bottom: 0.5rem;
		font-family: var(--font-sans);
		font-size: 1.2rem;
		font-weight: 700;
		font-stretch: 85%;
	}

	.legal__content :global(h2:first-child) {
		margin-top: 0;
	}

	.legal__content :global(p),
	.legal__content :global(ul) {
		margin-top: 0.75rem;
	}

	.legal__content :global(ul) {
		padding-left: 1.25rem;
		list-style: disc;
	}

	.legal__content :global(li + li) {
		margin-top: 0.3rem;
	}

	.legal__content :global(a) {
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-color: var(--color-rule-strong);
	}

	.legal__content :global(strong) {
		font-weight: 650;
	}
</style>
