---
import { getDict, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).statement;
---

<section class="statement">
	<div class="frame statement__inner">
		<blockquote>
			<p class="statement__first">{t.first}</p>
			<p class="statement__second">{t.second}</p>
		</blockquote>
	</div>
</section>

<style>
	.statement {
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.statement__inner {
		padding-block: clamp(4.5rem, 10vw, 8rem);
	}

	blockquote {
		max-width: 52rem;
	}

	.statement__first {
		font-family: var(--font-serif);
		font-size: clamp(1.9rem, 1.1rem + 3.2vw, 3.6rem);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.012em;
		text-wrap: balance;
		font-variation-settings: "opsz" 60;
	}

	.statement__second {
		max-width: 34rem;
		margin-top: 1.75rem;
		font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
		color: color-mix(in srgb, var(--color-paper) 75%, transparent);
	}

	@media (min-width: 60rem) {
		.statement__inner {
			padding-left: calc(var(--gutter) + var(--margin-col) + 3rem + 3px);
		}
	}
</style>
