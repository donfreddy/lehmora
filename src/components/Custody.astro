---
import Section from "./Section.astro";
import { getDict, type Lang } from "../i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).custody;
---

<Section id="custody" label={t.label} title={t.title}>
	<div class="prose">
		{t.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
	</div>

	<div class="flows">
		<figure class="flow-card">
			<figcaption class="flow-card__title">{t.escrow.title}</figcaption>
			<div class="flow flow--escrow">
				<div class="node">{t.escrow.payer}</div>
				<div class="edge"><span class="edge__label">{t.escrow.edgeIn}</span><span class="edge__line"></span></div>
				<div class="node node--holder">
					<strong>{t.escrow.holder}</strong>
					<span>{t.escrow.holderNote}</span>
				</div>
				<div class="edge"><span class="edge__label">{t.escrow.edgeOut}</span><span class="edge__line"></span></div>
				<div class="node">{t.escrow.payee}</div>
			</div>
			<p class="flow-card__held is-held">{t.escrow.held}</p>
		</figure>

		<figure class="flow-card">
			<figcaption class="flow-card__title">{t.direct.title}</figcaption>
			<div class="flow flow--direct">
				<div class="node">{t.direct.payer}</div>
				<div class="edge edge--long"><span class="edge__label">{t.direct.edge}</span><span class="edge__line"></span></div>
				<div class="node">{t.direct.payee}</div>
				<div class="registry">
					<strong>{t.direct.registry}</strong>
					<span>{t.direct.registryNote}</span>
				</div>
			</div>
			<p class="flow-card__held">{t.direct.held}</p>
		</figure>
	</div>
</Section>

<style>
	.prose {
		max-width: 40rem;
		margin-top: 2.25rem;
		font-family: var(--font-serif);
		font-size: 1.12rem;
		line-height: 1.68;
		color: var(--color-ink);
	}

	.prose p + p {
		margin-top: 1.1em;
	}

	.flows {
		display: grid;
		gap: 1.25rem;
		margin-top: 3rem;
	}

	.flow-card {
		padding: 1.25rem 1.25rem 1rem;
		background: var(--color-sheet);
		border: 1px solid var(--color-rule-strong);
	}

	.flow-card__title {
		font-weight: 700;
		font-stretch: 85%;
		font-size: 1.05rem;
	}

	.flow-card__held {
		margin-top: 1.1rem;
		padding-top: 0.7rem;
		border-top: 1px solid var(--color-rule);
		font-weight: 700;
		color: var(--color-green);
	}

	.flow-card__held.is-held {
		color: var(--color-debit);
	}

	/* Mobile: vertical flow. */
	.flow {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		margin-top: 1.1rem;
	}

	.node,
	.registry {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.15rem;
		padding: 0.7rem 0.85rem;
		background: var(--color-paper);
		border: 1.5px solid var(--color-ink);
		font-weight: 600;
		font-size: 0.95rem;
		text-align: center;
	}

	.node span,
	.registry span {
		font-weight: 400;
		font-size: 0.84rem;
		color: var(--color-ink-2);
	}

	.node--holder {
		border-color: var(--color-debit);
		color: var(--color-debit);
		box-shadow: inset 0 0 0 3px var(--color-paper), inset 0 0 0 4px var(--color-debit);
	}

	.node--holder span {
		color: var(--color-debit);
	}

	.registry {
		margin-top: 1rem;
		border-style: dashed;
		border-color: var(--color-green);
		color: var(--color-green);
	}

	.edge {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 3rem;
		padding-left: calc(50% - 0.75px);
	}

	.edge__line {
		order: -1;
		align-self: stretch;
		width: 0;
		border-left: 1.5px solid var(--color-ink);
		position: relative;
	}

	.edge__line::after {
		content: "";
		position: absolute;
		left: -5.5px;
		bottom: 0;
		border: 5px solid transparent;
		border-top: 7px solid var(--color-ink);
		border-bottom: 0;
	}

	.edge__label {
		font-size: 0.84rem;
		color: var(--color-ink-2);
	}

	/* Desktop: both flows share one five-column grid so they can be compared at a glance. */
	@media (min-width: 46rem) {
		.flow {
			display: grid;
			grid-template-columns: minmax(6.5rem, 0.8fr) minmax(5rem, 1fr) minmax(9rem, 1fr) minmax(5rem, 1fr) minmax(6.5rem, 0.8fr);
			align-items: center;
		}

		/* The line sits exactly on the nodes' centre line; the label floats above it. */
		.edge {
			display: block;
			min-height: 0;
			padding: 0 0.5rem;
			text-align: center;
		}

		.edge__label {
			position: absolute;
			left: 0.25rem;
			right: 0.25rem;
			bottom: calc(100% + 0.4rem);
			line-height: 1.3;
		}

		.flow {
			margin-top: 2.25rem;
		}

		.edge__line {
			display: block;
			order: 0;
			align-self: auto;
			width: auto;
			height: 0;
			border-left: 0;
			border-top: 1.5px solid var(--color-ink);
		}

		.edge__line::after {
			left: auto;
			right: -1px;
			bottom: auto;
			top: -6px;
			border: 5px solid transparent;
			border-left: 7px solid var(--color-ink);
			border-right: 0;
		}

		.edge--long {
			grid-column: 2 / span 3;
		}

		/* The register hangs beside the money flow, linked by a dashed line: it observes, it never holds. */
		.registry {
			grid-column: 3;
			grid-row: 2;
			position: relative;
			margin-top: 2.25rem;
		}

		.registry::before {
			content: "";
			position: absolute;
			left: 50%;
			bottom: 100%;
			height: 2.25rem;
			border-left: 1.5px dashed var(--color-green);
		}
	}
</style>
