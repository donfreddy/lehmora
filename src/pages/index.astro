---
import Layout from "../layouts/Layout.astro";
import Header from "../components/react/Header";
import Pattern from "../components/ui/Pattern.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Statement from "../components/Statement.astro";
import Dna from "../components/Dna.astro";
import Portfolio from "../components/Portfolio.astro";
import Footer from "../components/Footer.astro";
---

<Layout
	title="Lehmora Labs · Architectures financières et logicielles de demain"
	description="Venture Studio d'ingénierie logicielle pour les marchés émergents. Nous concevons, développons et opérons des infrastructures SaaS souveraines : Famsub, Tallyno, Payskool et Marge."
>
	<Header client:load />
	<main>
		<Hero />
		<Pattern />
		<About />
		<Statement />
		<Dna />
		<Pattern />
		<Portfolio />
	</main>
	<Footer />
</Layout>
